# ---------------------------------------------------------------------------
# Haggle Bot — copy this file to .env.local and fill it in.
# Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Brindle's brain (the pricing engine) ----------------------------------
# Groq is the default provider. Key from console.groq.com → API Keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional alternative provider. Only used when GROQ_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- PayPal REST app (sandbox) --------------------------------------------
# developer.paypal.com → Apps & Credentials → Sandbox → Create App (Merchant).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Same value as PAYPAL_CLIENT_ID. This one is exposed to the browser on purpose.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Sandbox by default. Do not point this at live until you mean it.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Deal signing ----------------------------------------------------------
# Any long random string (32+ chars). Signs the 10-minute deal token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEAL_SIGNING_SECRET=
